<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Team Task Manager</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      color: #243042;
      line-height: 1.6;
    }

    header {
      padding: 28px 20px;
      background: #23344d;
      color: white;
    }

    .container {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
    }

    h1 {
      margin: 0 0 10px;
    }

    h1,
    h3,
    p,
    dd,
    .badge {
      overflow-wrap: anywhere;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 20px;
    }

    nav a,
    nav button {
      padding: 12px 18px;
      border: 1px solid #d6deea;
      border-radius: 6px;
      font: inherit;
    }

    nav a {
      background: white;
      color: #23344d;
      text-decoration: none;
    }

    nav a:hover {
      background: #e8eef7;
    }

    nav a:focus-visible {
      outline: 3px solid #ffcf66;
      outline-offset: 3px;
    }

    nav button:disabled {
      background: #344762;
      color: #e0e6ef;
    }

    main {
      padding: 25px 20px;
    }

    .preview-note {
      color: #526071;
      margin-bottom: 20px;
    }

    .empty-state {
      padding: 35px 20px;
      border: 1px solid #dce2e8;
      border-radius: 8px;
      background: white;
      text-align: center;
    }

    .task-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit,
          minmax(min(100%, 300px), 1fr));
      gap: 20px;
    }

    .task-card {
      min-width: 0;
      padding: 24px;
      background: white;
      border: 1px solid #dce2e8;
      border-radius: 8px;
    }

    .task-card h3 {
      margin: 0 0 16px;
      font-size: 1.2rem;
    }

    .task-body {
      margin: 20px 0;
      white-space: pre-wrap;
    }

    .task-details {
      margin: 0 0 20px;
    }

    .task-details div {
      margin-bottom: 14px;
    }

    .task-details dt {
      font-weight: bold;
    }

    .task-details dd {
      margin: 3px 0 0;
      color: #526071;
    }

    .badge {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 5px;
      font-size: 0.85rem;
      font-weight: bold;
    }

    .priority-high {
      background: #ffe5e5;
      color: #921f1f;
    }

    .priority-medium {
      background: #fff0d6;
      color: #854600;
    }

    .priority-low,
    .status-completed {
      background: #e2f3e7;
      color: #216338;
    }

    .status-open {
      background: #e5edff;
      color: #244b91;
    }

    .status-in-progress {
      background: #fff0d6;
      color: #854600;
    }

    .priority-unset,
    .status-unset {
      background: #edf0f3;
      color: #465261;
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 1.6rem;
      }

      nav a,
      nav button {
        width: 100%;
        text-align: center;
      }
    }
  </style>
</head>

<body>
  <header>
    <div class="container">
      <h1>Team Task Manager</h1>
      <p>Keep your team's tasks in one place.</p>

      <nav aria-label="Main navigation">
        <a href="/tasks" aria-current="page">Tasks</a>
        <button type="button" disabled>
          Dashboard - Coming Soon
        </button>
      </nav>
    </div>
  </header>

  <section class="container">
    <%- include('partials/taskform') %>
  </section>

  <main class="container">
    <h2>Team Tasks</h2>

    <% if (isPreview) { %>
    <p class="preview-note">
      Preview - sample tasks for testing the layout.
    </p>
    <% } %>

    <% if (tasks.length === 0) { %>
    <section class="empty-state">
      <h3>No tasks found</h3>
      <p>Tasks will appear here after they are created.</p>
    </section>
    <% } else { %>
    <section class="task-grid" aria-label="Task list">
      <% tasks.forEach((task) => {
            const priority = String(task.priority || "")
              .trim()
              .toLowerCase();

            const priorityLabels = {
              high: "High",
              medium: "Medium",
              low: "Low"
            };

            const hasPriority = Object.prototype.hasOwnProperty.call(
              priorityLabels,
              priority
            );

            const priorityClass = hasPriority ? priority : "unset";
            const priorityLabel = hasPriority
              ? priorityLabels[priority]
              : "Not set";

            const statusKey = String(task.status || "")
              .trim()
              .toLowerCase()
              .replace(/[_-]+/g, " ")
              .replace(/\s+/g, " ");

            const statusClasses = {
              pending: "open",
              open: "open",
              "in progress": "in-progress",
              completed: "completed"
            };

            const statusLabels = {
              pending: "Open",
              open: "Open",
              "in progress": "In Progress",
              completed: "Completed"
            };

            const hasStatus = Object.prototype.hasOwnProperty.call(
              statusClasses,
              statusKey
            );

            const statusClass = hasStatus
              ? statusClasses[statusKey]
              : "unset";

            const statusLabel = hasStatus
              ? statusLabels[statusKey]
              : (task.status || "Not set");
          %>
      <article class="task-card">
        <h3><%= task.title %></h3>

        <span class="badge priority-<%= priorityClass %>">
          Priority: <%= priorityLabel %>
        </span>

        <p class="task-body"><%= task.body || "No description provided." %></p>

        <dl class="task-details">
          <div>
            <dt>Due date</dt>
            <dd><%= task.due_date || "No due date" %></dd>
          </div>

          <div>
            <dt>Assigned to</dt>
            <dd><%= task.assignee_email || "Unassigned" %></dd>
          </div>
        </dl>

        <span class="badge status-<%= statusClass %>">
          Status: <%= statusLabel %>
        </span>
      </article>
      <% }); %>
    </section>
    <% } %>
  </main>
</body>

</html>