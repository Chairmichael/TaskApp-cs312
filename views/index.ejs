<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/style.css">
	<title>CS312 TaskApp</title>
</head>
<body class="center-children">
	<form action="/" method="post" class="block">
		<h1>Log In</h1>

		<label for="username-field">Username</label>
		<input type="text" name="username" id="username-field" autocomplete="username" placeholder="johndoe123">

		<label for="password-field">Password</label>
		<input type="password" name="password" id="password-field" autocomplete="current-password" placeholder="mypassword">

		<input type="submit" value="Log In">
	</form>
</body>
</html>