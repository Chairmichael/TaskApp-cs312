<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/style.css">
	<title>CS312 TaskApp</title>
</head>
<body class="center-children">
	<form action="/auth/login" method="post" class="block">
		<h1>Log In</h1>

		<label for="email-field">Email</label>
		<input type="email" name="email" id="email-field" autocomplete="email" required>

		<label for="password-field">Password</label>
		<input type="password" name="password" id="password-field" autocomplete="current-password" required>

		<input type="submit" value="Log In">
	</form>
</body>
</html>